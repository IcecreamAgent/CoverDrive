# Copy to .env; supply YOUR OWN endpoints, model IDs and credentials.
# LLM: streaming OpenAI-compatible Chat Completions with tools.
LLM_BASE_URL=
LLM_MODEL_ID=
LLM_API_KEY=
LLM_DISABLE_THINKING=true
LLM_TIMEOUT=45
LLM_MAX_TOKENS=1024

# End-to-end voice: must implement the current native JSON WebSocket protocol.
# Speech and LLM credentials are independent. See README before running.
VOICE_PROVIDER=seeduplex
SEEDUPLEX_URL=
SEEDUPLEX_MODEL=
SEEDUPLEX_SPEAKER=
SEEDUPLEX_API_KEY=
# Alternative legacy app credentials (all required if no API key):
SEEDUPLEX_APP_ID=
SEEDUPLEX_ACCESS_KEY=
SEEDUPLEX_APP_KEY=
SEEDUPLEX_RESOURCE_ID=

BACKGROUND_TASKS_ENABLED=true
BACKGROUND_MAX_TASKS=8
BACKGROUND_MAX_CONCURRENCY=3
BACKGROUND_NOTIFY_DELAY=0.6

# No insurance service/customer data is bundled. Configure your own MCP first.
INSURANCE_TOOLS_ENABLED=false
INSURANCE_MCP_URL=http://127.0.0.1:8010/mcp
INSURANCE_WRITES_ENABLED=false

# Local access only by default. Set a strong token before any remote exposure.
VOICE_AUTH_TOKEN=
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# End calls after 60 seconds without user speech/text; only shorter limits are allowed.
VOICE_IDLE_TIMEOUT_SECONDS=60
